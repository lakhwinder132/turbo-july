generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  username String
  password String
  todos    Todo[]
}

model Todo {
  id     String  @id @default(uuid())
  task   String
  done   Boolean
  userId String
  user   User    @relation(fields: [userId], references: [id])
}