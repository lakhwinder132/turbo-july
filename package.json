{
  "name": "turbo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prisma-generate":"cd packages/db && npx prisma generate && cd ../..",
    "start:web":"cd apps/web && npm start",
    "build:web":"cd apps/web && npm run build && cd ../..",
    "createddisp":"cd packages/db && npx tsc -b && cd ../..",
    "start:http":"cd apps/http && node index.js ",
    "start:ws":"cd apps/ws && node index.js "
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.7",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.18.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
